#!/bin/bash
# Weak scaling sweep: fixed MBS, GBS scales linearly with nodes (32 * N).
# Usage: ./submit_weak_scaling.sh [--dry-run] [--time HH:MM:SS]

set -euo pipefail

JOB_SCRIPT="$(dirname "$(readlink -f "$0")")/pretrain_difflm.job"
NODE_COUNTS=(1 2 4 8 16 32 64 128 256)

GBS_PER_NODE=64
DRY_RUN=0
TIME_OVERRIDE=""

# Parse args
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --time)    TIME_OVERRIDE="$2"; shift 2 ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

if [[ ! -f "$JOB_SCRIPT" ]]; then
    echo "ERROR: job script not found: $JOB_SCRIPT"
    exit 1
fi

for N in "${NODE_COUNTS[@]}"; do
    GBS=$(( GBS_PER_NODE * N ))

    SBATCH_ARGS=(--nodes="$N")
    [[ -n "$TIME_OVERRIDE" ]] && SBATCH_ARGS+=(--time="$TIME_OVERRIDE")

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf "  %-8s  %-8s  %s\n" "$N" "$GBS" "(dry-run)"
    else
        JOB_ID=$(sbatch --parsable "${SBATCH_ARGS[@]}" "$JOB_SCRIPT")
        printf "  %-8s  %-8s  %s\n" "$N" "$GBS" "$JOB_ID"
    fi
done

echo ""
echo "Done."
